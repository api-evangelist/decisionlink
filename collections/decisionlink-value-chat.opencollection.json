          },
          "http": {
            "method": "POST",
            "url": "https://api.xfactor.io/v1/value-chat/generate-value-model",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Kick off async value model generation. Returns a job_id to poll."
        },
        {
          "info": {
            "name": "Stream value model generation status via Server-Sent Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.xfactor.io/stream/generate-value-model/:job_id/status",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "SSE stream emitting job state once per second until done or error."
        }
      ]
